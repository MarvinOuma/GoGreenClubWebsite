{
  "name": "gogreen-club-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src functions tests *.config.js --max-warnings 0",
    "test": "node --test tests/eventTime.test.mjs",
    "test:emulator": "npx --yes firebase-tools@15.9.1 emulators:exec --project demo-gogreen --only auth,firestore,functions,storage \"node --test --test-concurrency=1 tests/rules.test.mjs tests/workflows.test.mjs\"",
    "test:browser": "npx --yes firebase-tools@15.9.1 emulators:exec --project demo-gogreen --only auth,firestore,functions,storage \"playwright test\""
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "firebase": "^12.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
