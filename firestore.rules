rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function own(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function activeMember() {
      return signedIn() && exists(profilePath()) &&
        get(profilePath()).data.get('isActive', true) == true;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true &&
        (!exists(profilePath()) || (
          get(profilePath()).data.get('isActive', true) == true &&
          get(profilePath()).data.get('adminRevoked', false) == false
        ));
    }

    function textWithin(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function interestAt(values, index) {
      return index >= values.size() || textWithin(values[index], 80);
    }

    function validInterests(values) {
      return values is list && values.size() <= 25 &&
        interestAt(values, 0) && interestAt(values, 1) && interestAt(values, 2) && interestAt(values, 3) && interestAt(values, 4) &&
        interestAt(values, 5) && interestAt(values, 6) && interestAt(values, 7) && interestAt(values, 8) && interestAt(values, 9) &&
        interestAt(values, 10) && interestAt(values, 11) && interestAt(values, 12) && interestAt(values, 13) && interestAt(values, 14) &&
        interestAt(values, 15) && interestAt(values, 16) && interestAt(values, 17) && interestAt(values, 18) && interestAt(values, 19) &&
        interestAt(values, 20) && interestAt(values, 21) && interestAt(values, 22) && interestAt(values, 23) && interestAt(values, 24);
    }

    function validProfile() {
      let data = request.resource.data;
      return textWithin(data.name, 120) && textWithin(data.branch, 120) &&
        validInterests(data.interests);
    }

    function validReport() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'userId', 'status', 'activityType', 'wasteAmount', 'treesPlanted', 'description', 'createdAt'
      ]) &&
        own(data.userId) && data.status == 'pending' && data.createdAt == request.time &&
        data.activityType in ['recycling', 'tree_planting', 'cleanup', 'other'] &&
        data.wasteAmount is number && data.wasteAmount >= 0 && data.wasteAmount <= 10000 &&
        data.treesPlanted is int && data.treesPlanted >= 0 && data.treesPlanted <= 10000 &&
        textWithin(data.description, 2000);
    }

    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if own(userId) || isAdmin();
      allow create: if own(userId) &&
        request.resource.data.keys().hasOnly(['name', 'branch', 'interests']) && validProfile();
      allow update: if (own(userId) && activeMember() && validProfile() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'branch', 'interests']));
    }

    match /posts/{postId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if resource.data.isPublic == true || isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.get('registeredCount', 0) == 0 &&
        request.resource.data.get('registrationCountVersion', 2) == 2 &&
        !request.resource.data.keys().hasAny(['deleting']);
      allow update: if isAdmin() && resource.data.get('deleting', false) == false &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'registeredCount', 'deleting', 'registrationCountVersion'
        ]);
    }

    match /eventRegistrations/{registrationId} {
      allow read: if own(resource.data.userId) || isAdmin();
    }

    match /impactReports/{reportId} {
      allow read: if own(resource.data.userId) || isAdmin();
      allow create: if activeMember() && validReport();
    }

    match /partners/{partnerId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    match /partnerMessages/{messageId} {
      allow read, update, delete: if isAdmin();
    }

    match /publicStats/{statsId} {
      allow get: if statsId == 'overview';
    }
  }
}
