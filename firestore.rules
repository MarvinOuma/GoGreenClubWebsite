rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isActive() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) != false;
    }
    
    function eventExists(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId));
    }
    
    function getEvent(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }
    
    function isEventOpen(eventId) {
      let event = getEvent(eventId);
      return event.status != 'cancelled' && event.get('isPublic', true) != false;
    }

    function isValidProfilePayload() {
      return request.resource.data.name is string &&
             request.resource.data.branch is string &&
             request.resource.data.interests is list &&
             request.resource.data.interests.size() <= 25;
    }
    
    // Users collection
    match /users/{userId} {
      allow list: if true; // Public can count users for impact stats
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isOwnUser(userId) &&
                       request.resource.data.keys().hasOnly(['name', 'branch', 'interests']) &&
                       isValidProfilePayload();
      allow update: if (isOwnUser(userId) &&
                          request.resource.data.diff(resource.data).changedKeys().hasOnly(['name', 'branch', 'interests']) &&
                          isValidProfilePayload()) ||
                        isAdmin();
      allow delete: if isAdmin();
    }
    
    // Posts collection
    match /posts/{postId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    // Events collection
    match /events/{eventId} {
      allow read: if resource.data.get('isPublic', true) != false || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    // Event Registrations - Use composite key to prevent duplicates
    match /eventRegistrations/{registrationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Create: validate userId, eventId exists, event is open, user is active
      allow create: if isActive() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.eventId is string &&
                       eventExists(request.resource.data.eventId) &&
                       isEventOpen(request.resource.data.eventId) &&
                       request.resource.data.status == 'registered' &&
                       request.resource.data.keys().hasAll(['userId', 'eventId', 'registeredAt', 'status']);
      
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }
    
    // Impact Reports collection
    match /impactReports/{reportId} {
      allow read: if true; // Public can read approved reports for impact stats
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Partners (logos shown on home page)
    match /partners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Partner inquiries (public can create; admins can read/manage)
    match /partnerMessages/{messageId} {
      allow read: if isAdmin();

      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'organization', 'message', 'status', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.organization is string &&
        request.resource.data.message is string &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.email.size() <= 200 &&
        request.resource.data.organization.size() <= 120 &&
        request.resource.data.message.size() <= 2000;

      allow update, delete: if isAdmin();
    }
  }
}
